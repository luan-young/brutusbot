<?xml version="1.0"?>
<robot name="brutusbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Mount pose relative to base_footprint; see config/camera_mount.yaml -->
    <xacro:property name="camera_mount"
        value="${xacro.load_yaml('$(find brutusbot_description)/config/camera_mount.yaml')}" />
    <xacro:property name="camera_length" value="0.03" />
    <xacro:property name="camera_width" value="0.08" />
    <xacro:property name="camera_height" value="0.03" />
    <xacro:property name="camera_mass" value="0.05" />
    <xacro:property name="camera_support_size" value="0.015" />
    <xacro:property name="camera_support_mass" value="0.02" />
    <!-- Camera pose relative to base_link (base_joint is a pure translation) -->
    <xacro:property name="camera_x" value="${camera_mount['x'] - base_joint_x}" />
    <xacro:property name="camera_z" value="${camera_mount['z'] - base_joint_z}" />
    <!-- Vertical post from the top of the base to the bottom of the camera body -->
    <xacro:property name="camera_support_height" value="${camera_z - camera_height / 2.0 - base_height}" />

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
            <origin xyz="${-camera_length / 2.0} 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
            <origin xyz="${-camera_length / 2.0} 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia m="${camera_mass}" x="${camera_length}" y="${camera_width}" z="${camera_height}"
            o_xyz="${-camera_length / 2.0} 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="${camera_x} ${camera_mount['y']} ${camera_z}"
            rpy="${camera_mount['roll']} ${camera_mount['pitch']} ${camera_mount['yaw']}"/>
    </joint>

    <link name="camera_support_link">
        <visual>
            <geometry>
                <box size="${camera_support_size} ${camera_support_size} ${camera_support_height}"/>
            </geometry>
            <origin xyz="0 0 ${camera_support_height / 2.0}" rpy="0 0 0"/>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <box size="${camera_support_size} ${camera_support_size} ${camera_support_height}"/>
            </geometry>
            <origin xyz="0 0 ${camera_support_height / 2.0}" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia m="${camera_support_mass}" x="${camera_support_size}" y="${camera_support_size}"
            z="${camera_support_height}" o_xyz="0 0 ${camera_support_height / 2.0}" o_rpy="0 0 0"/>
    </link>

    <!-- Static, follows the nominal mount; it ignores the small roll/pitch/yaw a calibration may add -->
    <joint name="camera_support_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_support_link"/>
        <origin xyz="${camera_x - camera_length / 2.0} ${camera_mount['y']} ${base_height}" rpy="0 0 0"/>
    </joint>

    <!-- Optical frame: z forward, x right, y down -->
    <link name="camera_optical_link"/>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_optical_link"/>
        <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    </joint>

</robot>
